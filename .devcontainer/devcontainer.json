{
  "name": "QuickAnswer AI (React + FastAPI)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/main.py",
        "frontend/src/App.jsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r backend/requirements.txt && cd frontend && npm install",
  "postAttachCommand": {
    "server": "python3 run_dev.py"
  },
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "openPreview"
    },
    "5173": {
      "label": "React Vite Frontend",
      "onAutoForward": "openBrowser"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ]
}